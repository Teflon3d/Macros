########################################
# TIRA LED CONFIGURABLE
######################################## 

[neopixel tira_led]
pin: PE6                         # Pin Conexión placa
chain_count: 25           # Número de LEDs 
color_order: GRB
initial_RED:   0.0          # Rojo
initial_GREEN: 0.0      # Verde
initial_BLUE:  0.0        # Azul

########################## MACROS #################################

########################################
# ILUMINACIÓN 
########################################

[gcode_macro LED_ON]
description: Encender LEDs Neopixel
gcode:
    SET_LED LED=tira_led RED=0.8 GREEN=0.8 BLUE=0.8

[gcode_macro LED_OFF]
description: Apagar LEDs Neopixel
gcode:
    SET_LED LED=tira_led RED=0 GREEN=0 BLUE=0 


