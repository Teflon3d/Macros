########################################
# ESTADOS DE LA IMPRESORA
########################################

[gcode_macro LED_LEVELING]
description: Nivelación
gcode:
    SET_LED LED=tira_led RED=0.1 GREEN=0.4 BLUE=1.0
    

[gcode_macro LED_HEATING]
description: Calentanto cama y extrusor
gcode:
    SET_LED LED=tira_led RED=1.00 GREEN=0.33 BLUE=0.00


[gcode_macro LED_STARTING]
description: Iniciando impresión
gcode:
    SET_LED LED=tira_led RED=0.00 GREEN=1.00 BLUE=0.27

    

[gcode_macro LED_PRINTING]
description: Imprimiendo
gcode:
    SET_LED LED=tira_led RED=1.0 GREEN=1.0 BLUE=1.0


[gcode_macro LED_SUCCESS]
description: Impresión finalizada
